oints", "label": "Discover API Endpoints", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_browsemode", "label": "BrowseMode", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_browsemodedefinition", "label": "BrowseModeDefinition", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_browsepicker", "label": "BrowsePicker", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_tmdb_api", "label": "TMDb API", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_rank_badges", "label": "Rank Badges", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_preset_persistence", "label": "Per-Mode Sort Persistence", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_getsettingskey", "label": "getSettingsKey Scoping", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_itemsortby_closed", "label": "ItemSortBy Closed Enum Constraint", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_server_plugin_rationale", "label": "Server Can Be Plugin", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IUserManager, ILibraryManager, IDtoService are in published Jellyfin.Controller; IScheduledTask is in Jellyfin.Model with auto-discovery; plugin controllers are auto-routed via mvcBuilder.AddApplicationPart. Therefore the server half can be a plugin rather than a fork."}, {"id": "docs_technical_ui_plugin_impossible", "label": "UI Cannot Be Plugin", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exhaustive investigation of all extension vectors: plugin pages require admin-level ServerContentPage; no CustomJs counterpart to CustomCss exists; route table is built statically at import time; pluginManager relies on build-time webpack context; server only serves static files as-is. The tile page requires a jellyfin-web fork permanently."}, {"id": "docs_technical_web_router_interception", "label": "Web Router Interception (appRouter.js:410)", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_tv_launcher_interception", "label": "TV Launcher Interception (ItemLauncher.java)", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_shouldshowbrowsemodes", "label": "shouldShowBrowseModes Guard", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_tile_inventory", "label": "Tile Inventory", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_decades_age_rating", "label": "Decades and Age Rating Pickers", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_icon_colours", "label": "Icon Colours", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_two_step_studios", "label": "Two-Step Studios Flow (TV)", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sample library of 56 films carries 209 studios. ByGenreFragment would fire 209 concurrent requests on open. Studios use ByStudioFragment (grid of studio cards) -> StudioItemsFragment instead, fetching on demand."}, {"id": "docs_technical_seed_once", "label": "Seed-Once Preset Semantics", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Presets are applied as defaults for fresh localStorage/preferences keys, not reapplied on every visit. This lets users adjust sort within a mode without it resetting, while keeping the plain library view undisturbed."}, {"id": "docs_technical_owned_only", "label": "Owned Content Only", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trending and Top Rated only show titles already in the user's library. Showing unowned content would produce dead clicks; Jellyseerr already solves discovery-then-request properly."}, {"id": "docs_technical_no_imdb_250", "label": "No IMDb Top 250", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IMDb has no free API and scraping breaks their terms. TMDB Top Rated was used instead for the Top Rated tile."}, {"id": "docs_technical_copylocallockfileassemblies", "label": "CopyLocalLockFileAssemblies", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A library build does not copy NuGet dependencies to output, but a plugin is loaded from a folder rather than through deps.json. Without this flag, only the plugin DLL is output and TMDbLib would be missing at runtime."}, {"id": "docs_technical_excludeassets_runtime", "label": "ExcludeAssets Runtime", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With CopyLocalLockFileAssemblies enabled, Jellyfin packages would be copied into the plugin folder, and PluginManager loads every DLL into the plugin's own AssemblyLoadContext \u2014 producing duplicate type identities for server-provided types and failing casts."}, {"id": "docs_technical_assemblyloadcontext_issue", "label": "AssemblyLoadContext Type Identity Problem", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_cache_warming", "label": "Scheduled TMDb Cache Warming", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_user_supplied_key", "label": "User-Supplied TMDb Key Requirement", "file_type": "rationale", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server bundles a TMDb key in MediaBrowser.Providers which the plugin cannot reference. Users must supply their own free key in plugin settings."}, {"id": "docs_technical_tmdb_bundled_key", "label": "TMDb Bundled Key (Unreachable)", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_browsemodesfragment", "label": "BrowseModesFragment (TV)", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_discoverfragment", "label": "DiscoverFragment (TV)", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_bystudiofragment", "label": "ByStudioFragment (TV)", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_discovercardpresenter", "label": "DiscoverCardPresenter (TV)", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_hasanyproviderids", "label": "HasAnyProviderIds", "file_type": "code", "source_file": "docs/TECHNICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technical_indexnumber_rank", "label": "IndexNumber Rank Position", "file_type": "concept", "source_file": "docs/TECHNICAL.md", "source_location": null, "